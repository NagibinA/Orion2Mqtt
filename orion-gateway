            // Функция CRC8
            auto crc8 = [&](unsigned char* data, int size) -> unsigned char {
              unsigned char crc = 0;
              for (int i = 0; i < size; i++) {
                crc = crcTable[crc ^ data[i]];
              }
              return crc;
            };
            
            // Парсинг команды из MQTT
            String value = String(x.c_str());
            unsigned char DATA_N[76];
            
            // Первый байт (адрес)
            DATA_N[0] = value.substring(0, value.indexOf(';')).toInt();
            value = value.substring(value.indexOf(';') + 1);
            
            // Второй байт (длина команды)
            unsigned char byte1 = value.substring(0, value.indexOf(';')).toInt();
            DATA_N[1] = value.substring(0, value.indexOf(';')).toInt();
            value = value.substring(value.indexOf(';') + 1);
            
            // Остальные байты команды
            for (unsigned char i = 2; i < byte1; ++i) {
              DATA_N[i] = value.substring(0, value.indexOf(';')).toInt();
              value = value.substring(value.indexOf(';') + 1);
            }
            
            // Формирование пакета для отправки
            unsigned char count = DATA_N[1];
            unsigned char datan[76];
            for (unsigned char i = 0; i < count; ++i) {
              datan[i] = DATA_N[i];
            }
            
            // Добавление CRC8
            datan[count] = crc8(datan, count);
            
            // Отправка через RS485
            // Включаем режим передачи
            id(rs485_rts).set_level(1);
            delay(10);
            
            // Отправляем данные
            for (int i = 0; i < count + 1; i++) {
              id(uart_bus).write_byte(datan[i]);
            }
            id(uart_bus).flush();
            delay(7);
            
            // Переключаемся обратно в режим приема
            id(rs485_rts).set_level(0);
            
            // Ожидание ответа от устройства (максимум 200 мс)
            String messg_answer = "";
            unsigned long start = millis();
            unsigned char buff[256];
            unsigned char buff_len = 0;
            bool found = false;
            
            while ((millis() - start) < 200 && !found) {
              while (id(uart_bus).available() > 0 && !found) {
                int b = id(uart_bus).read();
                if (b != -1) {
                  buff[buff_len++] = (unsigned char)b;
                  messg_answer += String(b) + " ";
                  
                  // Проверяем, получен ли полный пакет
                  if (buff_len > 3) {
                    unsigned char sz = buff[1];
                    if (sz > 3 && buff_len > sz) {
                      // Проверяем CRC
                      if (crc8(buff, sz + 1) == 0) {
                        found = true;
                        // Публикуем ответ в MQTT
                        id(mqtt_client).publish("WemosOrion/answer", messg_answer.c_str());
                      }
                    }
                  }
                }
              }
              delay(2);
            }

# Output для управления RTS (DE/RE) на MAX485
output:
  - platform: gpio
    id: rs485_rts
    pin: GPIO2

# UART для RS485
uart:
  id: uart_bus
  tx_pin: GPIO17
  rx_pin: GPIO16
  baud_rate: 9600
  rx_buffer_size: 256
